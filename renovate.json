{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:base",
    ":semanticCommitTypeAll(chore)",
    ":semanticCommitScopeDisabled",
    "docker:disable"
  ],
  "minimumReleaseAge": "7 days",
  "schedule": ["before 4am on monday"],
  "groupName": "all dependencies",
  "groupSlug": "all",
  "lockFileMaintenance": {
    "enabled": false
  },
  "packageRules": [
    {
      "groupName": "all dependencies",
      "groupSlug": "all",
      "matchPackagePatterns": [
        "*"
      ]
    },
    {
      "description": "TestFormattedPromQL asserts every dashboard expression matches this parser's pretty-printer, so a bump reformats ~1800 expressions at once. Keep it out of the grouped PR so the reformat is reviewable on its own.",
      "matchPackageNames": [
        "github.com/prometheus/prometheus"
      ],
      "groupName": "prometheus promql parser",
      "groupSlug": "promql-parser"
    }
  ],
  "separateMajorMinor": false
}