      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "exemplar": false,
          "expr": "eseries_interface_read_latency{array=~\"$Array\",channel_type=~\"$ChannelType\",controller=~\"$Controller\",datacenter=~\"$Datacenter\"}\nand on (datacenter, id, array)\n  topk(\n    $TopResources,\n    max by (datacenter, id, array) (\n      avg_over_time(\n        eseries_interface_read_latency{array=~\"$Array\",channel_type=~\"$ChannelType\",controller=~\"$Controller\",datacenter=~\"$Datacenter\"}[3h] @ end()\n      )\n    )\n  )",
          "interval": "",
          "legendFormat": "{{array}} - {{controller}} - {{interface}}",
          "refId": "A"
        }
      ],
      "title": "Top $TopResources Interfaces by Read Latency",
      "type": "timeseries"
