  "description": "E-Series Major Event Log (MEL) - significant events reported by the array, such as drive and controller failures, redundancy loss, pool capacity thresholds, and configuration problems. Requires the Eseries collector (for array discovery) and the EseriesMel collector (for events) to both be enabled for the poller.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "panels": [],
      "title": "Important Information",
      "type": "row"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 4,
        "w": 24,
        "x": 0,
        "y": 1
      },
      "id": 2,
      "options": {
        "code": {
          "language": "plaintext",
          "showLineNumbers": false,
          "showMiniMap": false
        },
        "content": "<br>\n\nThis dashboard shows events **Harvest collected while running**, within the time range selected at the top right (default: last 24 hours). Events that occurred before Harvest started polling an array are not shown \u2014 the collector starts at the array's current log position and does not backfill history. How far back you can look is also bounded by your Prometheus retention.\n\nRequires both the [Eseries collector](https://netapp.github.io/harvest/nightly/configure-eseries/) (for array discovery, used by the Datacenter/Array filters above) and the [EseriesMel collector](https://netapp.github.io/harvest/nightly/configure-eseries/#eseriesmel-collector) (for events) to be enabled for the poller in Harvest configuration.",
        "mode": "markdown"
      },
      "pluginVersion": "12.3.2",
      "type": "text"
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 5
      },
      "id": 3,
      "panels": [],
      "title": "Highlights",
      "type": "row"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "Number of distinct MEL events (event type and location) reported by the selected arrays over the dashboard time range. Repeat occurrences of the same event at the same location count once.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
          "noValue": "0",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": 0
              }
            ]
          },
          "unit": "locale"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 11,
        "w": 6,
        "x": 0,
        "y": 6
      },
      "id": 4,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "percentChangeColorMode": "standard",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showPercentChange": false,
        "text": {},
        "textMode": "auto",
        "wideLayout": true
      },
      "pluginVersion": "12.3.2",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "exemplar": false,
          "expr": "count(last_over_time(eseries_mel_events{array=~\"$Array\",datacenter=~\"$Datacenter\"}[$__range]))",
          "format": "time_series",
          "instant": true,
          "interval": "",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "title": "Distinct Events",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "Distinct MEL events broken down by severity over the dashboard time range. Repeat occurrences of the same event at the same location count once.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "hideFrom": {
              "legend": false,
              "tooltip": false,
              "viz": false
            }
          },
          "decimals": 0,
          "mappings": [],
          "min": 0,
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 11,
        "w": 18,
        "x": 6,
        "y": 6
      },
      "id": 5,
      "options": {
        "displayLabels": [
          "value"
        ],
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "values": [
            "value"
          ]
        },
        "pieType": "donut",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "sort": "desc",
        "tooltip": {
          "hideZeros": false,
          "mode": "multi",
          "sort": "desc"
        }
      },
      "pluginVersion": "12.3.2",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "exemplar": false,
          "expr": "count by (severity) (\n  last_over_time(eseries_mel_events{array=~\"$Array\",datacenter=~\"$Datacenter\"}[$__range])\n)",
          "format": "time_series",
          "instant": true,
          "interval": "",
          "legendFormat": "{{severity}}",
          "refId": "A"
        }
      ],
      "title": "Events by Severity",
      "type": "piechart"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "Major Event Log (MEL) entries reported by the selected arrays, newest first.\n\nEach row is one event, identified by its event type and location. If the same event recurred at the same location, the row shows the most recent occurrence.\n\n#### Panel Columns:\n\n- **Datacenter**: Datacenter of the array, as configured in `harvest.yml`.\n- **Array**: The array that logged the event.\n- **Last Occurrence**: When the event was most recently logged by the array.\n- **Severity**: Event priority as reported by SANtricity (critical, warning, info, and so on).\n- **Event**: The MEL event name, for example `MEL_EV_CFG_DRIVE_FAILURE`. Only event types listed in the collector's `events` template are collected.\n- **Event Type**: The numeric SANtricity event code.\n- **Component**: The kind of component the event refers to, such as drive, tray, or controller.\n- **Location**: Where the component sits in the array, for example `Tray 1, Slot 5`.\n- **Chassis Serial**: Chassis serial number of that array.\n- **SANtricity Version**: Management software version running on the array.\n",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "filterable": true,
            "footer": {
              "reducers": []
            },
            "inspect": false
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": 0
              }
            ]
          },
          "unit": "string"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Last Occurrence"
            },
            "properties": [
              {
                "id": "unit",
                "value": "dateTimeAsIso"
              },
              {
                "id": "custom.align",
                "value": "left"
              },
              {
                "id": "custom.width",
                "value": 190
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Severity"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 110
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Event"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 330
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Event Type"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 100
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Array"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "targetBlank": true,
                    "title": "",
                    "url": "/d/eseries-array/e-series-array?orgId=1&${Datacenter:queryparam}&${__url_time_range}&var-Array=${__value.raw}"
                  }
                ]
              }
            ]
          }
        ]
      },
      "gridPos": {
        "h": 18,
        "w": 24,
        "x": 0,
        "y": 17
      },
      "id": 6,
      "options": {
        "cellHeight": "sm",
        "footer": {
          "countRows": false,
          "fields": "",
          "reducer": [
            "sum"
          ],
          "show": false
        },
        "showHeader": true,
        "sortBy": [
          {
            "desc": true,
            "displayName": "Last Occurrence"
          }
        ]
      },
      "pluginVersion": "12.3.2",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "exemplar": false,
          "expr": "last_over_time(eseries_mel_events{array=~\"$Array\",datacenter=~\"$Datacenter\"}[$__range])",
          "format": "table",
          "instant": true,
          "interval": "",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "title": "MEL Events (${__from:date:YYYY-MM-DD HH:mm} to ${__to:date:YYYY-MM-DD HH:mm})",
      "transformations": [
        {
          "id": "calculateField",
          "options": {
            "alias": "Last Occurrence",
            "binary": {
              "left": "Value",
              "operator": "*",
              "reducer": "sum",
              "right": "1000"
            },
            "mode": "binary",
            "reduce": {
              "reducer": "sum"
            }
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Value": true,
              "__name__": true,
              "instance": true,
              "job": true
            },
            "indexByName": {
              "Last Occurrence": 2,
              "array": 1,
              "chassis_serial": 8,
              "component_type": 6,
              "datacenter": 0,
              "event_type": 5,
              "location": 7,
              "management_version": 9,
              "message": 4,
              "severity": 3
            },
            "renameByName": {
              "array": "Array",
              "chassis_serial": "Chassis Serial",
              "component_type": "Component",
              "datacenter": "Datacenter",
              "event_type": "Event Type",
              "location": "Location",
              "management_version": "SANtricity Version",
              "message": "Event",
              "severity": "Severity"
            }
          }
        }
      ],
      "type": "table"
    }
  ],
