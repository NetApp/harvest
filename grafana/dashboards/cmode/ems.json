          "exemplar": false,
          "expr": "count by (severity) (\n              max_over_time(\n                ems_events{cluster=~\"$Cluster\",datacenter=~\"$Datacenter\",message=~\"$Message\",severity=~\"emergency|alert|error|notice|informational\"}[$__interval]\n              )\n            ==\n              1\n          )\n        or\n          label_replace(vector(0), \"severity\", \"emergency\", \"\", \"\")\n      or\n        label_replace(vector(0), \"severity\", \"alert\", \"\", \"\")\n    or\n      label_replace(vector(0), \"severity\", \"error\", \"\", \"\")\n  or\n    label_replace(vector(0), \"severity\", \"notice\", \"\", \"\")\nor\n  label_replace(vector(0), \"severity\", \"informational\", \"\", \"\")",
          "instant": false,
          "interval": "3m",
          "legendFormat": "{{severity}}",
          "refId": "A"
        }
      ],
      "title": "Event Timeline",
      "type": "timeseries"
    },
